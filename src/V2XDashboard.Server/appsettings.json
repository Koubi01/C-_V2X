{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PcapDataPath": "./hh/PcapData",
  "Ingestion": {
    "Scheduler": {
      "Enabled": true,
      "IsSchedulerNode": true,
      "IntervalSeconds": 30
    }
  },
  "MapConfig": {
    "TileStyleUrl": "http://localhost:8081/styles/basic-preview/style.json",
    "DefaultCenterLatitude": 49.8209,
    "DefaultCenterLongitude": 18.2625,
    "DefaultZoom": 13,
    "MinZoom": 3,
    "MaxZoom": 20
  }
}
