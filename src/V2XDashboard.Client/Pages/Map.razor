@page "/map"
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Map</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="map-page">
    <MudStack Spacing="3">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@errorMessage</MudAlert>
        }

        <MudPaper Class="panel-card" Elevation="0">
            <MudStack Spacing="3">
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="map-legend-row">
                    @foreach (var layer in MessageLayers)
                    {
                        <MudChip T="string" Class="@($"legend-chip {layer.ChipClass}")">@layer.Label</MudChip>
                    }
                </MudStack>

                @if (selectedLayers.Contains(TrafficIntensityLayerName))
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="map-legend-row">
                        <MudChip T="string" Class="legend-chip legend-chip-traffic-1">SV &lt;= 2,000</MudChip>
                        <MudChip T="string" Class="legend-chip legend-chip-traffic-2">2,001 - 5,000</MudChip>
                        <MudChip T="string" Class="legend-chip legend-chip-traffic-3">5,001 - 10,000</MudChip>
                        <MudChip T="string" Class="legend-chip legend-chip-traffic-4">10,001 - 20,000</MudChip>
                        <MudChip T="string" Class="legend-chip legend-chip-traffic-5">SV > 20,000</MudChip>
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">All provided rows included</MudChip>
                    </MudStack>
                }

                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6" lg="3">
                        <MudTextField T="string" Label="From" Variant="Variant.Outlined" InputType="InputType.DateTimeLocal" @bind-Value="fromTimeText" />
                    </MudItem>
                    <MudItem xs="12" md="6" lg="3">
                        <MudTextField T="string" Label="To" Variant="Variant.Outlined" InputType="InputType.DateTimeLocal" @bind-Value="toTimeText" />
                    </MudItem>

                    <MudItem xs="12" md="6" lg="6">
                        <MudText Typo="Typo.subtitle2">Security Filters</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="map-toggle-row">
                            <MudCheckBox @bind-Value="showSecureSigned" Label="Signed" Color="Color.Info" />
                            <MudCheckBox @bind-Value="showSecureEncrypted" Label="Encrypted" Color="Color.Info" />
                        </MudStack>
                    </MudItem>

                    <MudItem xs="4" lg="4">
                        <MudText Typo="Typo.subtitle2">Visible Layers</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="map-toggle-row">
                            @foreach (var layer in MessageLayers)
                            {
                                <MudCheckBox T="bool"
                                             @key="layer.Name"
                                             Value="@selectedLayers.Contains(layer.Name)"
                                             ValueChanged="@((bool isChecked) => OnLayerToggled(layer.Name, isChecked))"
                                             Label="@layer.Label"
                                             Color="Color.Primary"
                                             Disabled="@isLoading" />
                            }
                        </MudStack>
                    </MudItem>

                    <MudItem xs="4" lg="4">
                        <MudText Typo="Typo.subtitle2">Station Types</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="map-filter-checkbox-row">
                            @foreach (var stationType in StationTypeOptions)
                            {
                                <MudCheckBox T="bool"
                                             @key="stationType.Value"
                                             Value="@selectedStationTypes.Contains(stationType.Value)"
                                             ValueChanged="@((bool isChecked) => OnStationTypeToggled(stationType.Value, isChecked))"
                                             Label="@stationType.Label"
                                             Color="Color.Primary"
                                             Disabled="@isLoading" />
                            }
                        </MudStack>
                    </MudItem>

                    <MudItem xs="4" lg="4">
                        <MudText Typo="Typo.subtitle2">Vehicle Roles</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="map-filter-checkbox-row">
                            @foreach (var role in VehicleRoleOptions)
                            {
                                <MudCheckBox T="bool"
                                             @key="role.Value"
                                             Value="@selectedVehicleRoleCodes.Contains(role.Value)"
                                             ValueChanged="@((bool isChecked) => OnVehicleRoleToggled(role.Value, isChecked))"
                                             Label="@role.Label"
                                             Color="Color.Primary"
                                             Disabled="@isLoading" />
                            }
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" lg="12">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Class="map-toolbar-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFiltersAsync" Disabled="@isLoading">Apply Filters</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetFiltersAsync" Disabled="@isLoading">Reset</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="RecordCorrelationsAsync" Disabled="@isLoading">Rebuild Correlations</MudButton>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" lg="4">
                <MudPaper Class="metric-card" Elevation="0">
                    <MudText Typo="Typo.overline">Distinct Vehicles (@vehicleSummaryScopeLabel)</MudText>
                    <MudText Typo="Typo.h3">@filteredDistinctVehicleCount</MudText>
                    <MudText Typo="Typo.body2">Distinct StationId values matching current map filters.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" lg="8">
                <MudPaper Class="panel-card" Elevation="0">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6">Station Type Share</MudText>
                            <MudCheckBox T="bool"
                                         Value="@useCenterTileScope"
                                         ValueChanged="OnUseCenterTileScopeChangedAsync"
                                         Label="Use center tile"
                                         Color="Color.Info"
                                         Disabled="@isLoading" />
                        </MudStack>
                        @if (isVehicleSummaryLoading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        @if (!string.IsNullOrWhiteSpace(vehicleSummaryErrorMessage))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Error">@vehicleSummaryErrorMessage</MudText>
                        }
                        @if (stationTypeShares.Count == 0)
                        {
                            <MudText Typo="Typo.body2">No station-type distribution available for the current filters.</MudText>
                        }
                        else
                        {
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                @foreach (var share in stationTypeShares)
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">
                                        @GetStationTypeLabel(share.StationType): @share.DistinctVehicles (@share.Percentage.ToString("0.##")%)
                                    </MudChip>
                                }
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        <MudPaper Class="map-shell" Elevation="0">
            <div id="v2x-map" class="map-canvas"></div>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private const string TrafficIntensityLayerName = "TrafficIntensity";

    private sealed record LayerOption(string Name, string Label, string ChipClass);
    private sealed record StationTypeOption(int Value, string Label);
    private sealed record VehicleRoleOption(string Value, string Label);
    private sealed record TileFilterPayload(
        string[] VisibleLayers,
        string? FromTime,
        string? ToTime,
        bool? IsSecureSigned,
        bool? IsSecureEncrypted,
        int[] StationTypes,
        string[] VehicleRoles);
    private sealed record MapViewportBoundsPayload(
        double MinLatitude,
        double MaxLatitude,
        double MinLongitude,
        double MaxLongitude,
        int TileZ,
        int TileX,
        int TileY);

    private static readonly LayerOption[] MessageLayers =
    [
        new(TileLayerNames.Cam, "CAM", "legend-chip-cam"),
        new(TileLayerNames.Denm, "DENM", "legend-chip-denm"),
        new(TileLayerNames.Mapem, "MAPEM", "legend-chip-mapem"),
        new(TileLayerNames.Spatem, "SPATEM", "legend-chip-spatem"),
        new(TileLayerNames.Srem, "SREM", "legend-chip-srem"),
        new(TileLayerNames.Ssem, "SSEM", "legend-chip-ssem"),
        new(TileLayerNames.Correlations, "Correlations", "legend-chip-correlations"),
        new(TrafficIntensityLayerName, "Traffic (SV)", "legend-chip-traffic")
    ];

    private static readonly StationTypeOption[] StationTypeOptions =
    [
        new(0, "0 - Unknown"),
        new(5, "5 - Passenger Car"),
        new(6, "6 - Bus"),
        new(11, "11 - Tram"),
        new(15, "15 - RSU")
    ];

    private static readonly IReadOnlyDictionary<int, string> StationTypeLabelsByValue =
        StationTypeOptions.ToDictionary(option => option.Value, option => option.Label);

    private static readonly VehicleRoleOption[] VehicleRoleOptions =
    [
        new("0", "Unknown"),
        new("1", "Public Transport"),
        new("5", "Rescue"),
        new("6", "Emergency"),
    ];

    private bool isInitialized;
    private bool isLoading;
    private string? errorMessage;
    private CancellationTokenSource? diagnosticsPollingCts;
    private Task? diagnosticsPollingTask;
    private string? lastDiagnosticsFingerprint;
    private string? fromTimeText;
    private string? toTimeText;
    private bool showSecureSigned = true;
    private bool showSecureEncrypted = true;
    private bool isVehicleSummaryLoading;
    private int filteredDistinctVehicleCount;
    private string vehicleSummaryScopeLabel = "Global";
    private string? vehicleSummaryErrorMessage;
    private List<StationTypeShareDto> stationTypeShares = new();
    private bool useCenterTileScope;
    private DotNetObjectReference<Map>? mapDotNetReference;
    private TileFilterPayload? lastAppliedFilters;
    private CancellationTokenSource? vehicleSummaryRefreshCts;
    private HashSet<string> selectedLayers = new(StringComparer.OrdinalIgnoreCase)
    {
        TileLayerNames.Cam,
        TileLayerNames.Denm,
        TileLayerNames.Mapem,
        TileLayerNames.Spatem,
        TileLayerNames.Srem,
        TileLayerNames.Ssem,
        TileLayerNames.Correlations,
        TrafficIntensityLayerName
    };
    private HashSet<int> selectedStationTypes = StationTypeOptions.Select(option => option.Value).ToHashSet();
    private HashSet<string> selectedVehicleRoleCodes = VehicleRoleOptions.Select(option => option.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var config = await Http.GetFromJsonAsync<MapConfigDto>("api/map/config");
            if (config is null)
            {
                errorMessage = "Map configuration could not be loaded.";
                StateHasChanged();
                return;
            }

            await JS.InvokeVoidAsync(
                "v2xMap.initializeMap",
                "v2x-map",
                config.TileStyleUrl,
                config.DefaultCenterLongitude,
                config.DefaultCenterLatitude,
                config.DefaultZoom,
                config.MinZoom,
                config.MaxZoom);

            isInitialized = true;
            mapDotNetReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("v2xMap.registerViewportChangedCallback", mapDotNetReference);
            await ApplyFiltersAsync();
            StartDiagnosticsPolling();
        }
        catch (Exception ex)
        {
            errorMessage = $"Map initialization failed: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        if (!isInitialized)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var fromTimeValue = ParseLocalDateTime(fromTimeText);
            var toTimeValue = ParseLocalDateTime(toTimeText);

            if (fromTimeValue.HasValue && toTimeValue.HasValue && fromTimeValue.Value > toTimeValue.Value)
            {
                errorMessage = "From time must be earlier than or equal to To time.";
                return;
            }

            var filters = new TileFilterPayload(
                selectedLayers.OrderBy(layer => layer, StringComparer.OrdinalIgnoreCase).ToArray(),
                fromTimeValue?.ToString("O"),
                toTimeValue?.ToString("O"),
                ResolveSecureSignedFilter(),
                ResolveSecureEncryptedFilter(),
                selectedStationTypes.OrderBy(value => value).ToArray(),
                selectedVehicleRoleCodes.OrderBy(value => value, StringComparer.OrdinalIgnoreCase).ToArray());

            await JS.InvokeVoidAsync("v2xMap.applyTileFilters", filters);
            lastAppliedFilters = filters;
            await RefreshVehicleSummaryAsync(filters, showLoadingIndicator: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to apply map filters: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ResetFiltersAsync()
    {
        selectedLayers = new HashSet<string>(MessageLayers.Select(layer => layer.Name), StringComparer.OrdinalIgnoreCase);
        selectedStationTypes = StationTypeOptions.Select(option => option.Value).ToHashSet();
        selectedVehicleRoleCodes = VehicleRoleOptions.Select(option => option.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
        showSecureSigned = true;
        showSecureEncrypted = true;
        fromTimeText = null;
        toTimeText = null;
        await ApplyFiltersAsync();
    }

    private async Task OnLayerToggled(string layerName, bool isChecked)
    {
        if (isChecked)
        {
            selectedLayers.Add(layerName);
        }
        else
        {
            selectedLayers.Remove(layerName);
        }

        await ApplyFiltersAsync();
    }

    private async Task OnStationTypeToggled(int stationType, bool isChecked)
    {
        if (isChecked)
        {
            selectedStationTypes.Add(stationType);
        }
        else
        {
            selectedStationTypes.Remove(stationType);
        }

        await ApplyFiltersAsync();
    }

    private async Task OnVehicleRoleToggled(string roleCode, bool isChecked)
    {
        if (isChecked)
        {
            selectedVehicleRoleCodes.Add(roleCode);
        }
        else
        {
            selectedVehicleRoleCodes.Remove(roleCode);
        }

        await ApplyFiltersAsync();
    }

    private bool? ResolveSecureSignedFilter()
    {
        if (showSecureSigned && showSecureEncrypted)
        {
            return null;
        }

        return showSecureSigned;
    }

    private bool? ResolveSecureEncryptedFilter()
    {
        if (showSecureSigned && showSecureEncrypted)
        {
            return null;
        }

        return showSecureEncrypted;
    }

    private async Task RecordCorrelationsAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync("api/correlations/record", null);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Correlation rebuild failed: {body}";
                return;
            }

            Snackbar.Add("Correlation records rebuilt.", Severity.Success);
            await ApplyFiltersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Correlation rebuild failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static DateTime? ParseLocalDateTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return DateTime.TryParse(value, out var parsed) ? parsed : null;
    }

    [JSInvokable]
    public async Task OnMapViewportChanged()
    {
        if (!isInitialized || isLoading || lastAppliedFilters is null)
        {
            return;
        }

        await RefreshVehicleSummaryAsync(lastAppliedFilters, showLoadingIndicator: false);
    }

    private async Task OnUseCenterTileScopeChangedAsync(bool value)
    {
        useCenterTileScope = value;

        if (lastAppliedFilters is null)
        {
            return;
        }

        await RefreshVehicleSummaryAsync(lastAppliedFilters, showLoadingIndicator: true);
    }

    private async Task RefreshVehicleSummaryAsync(TileFilterPayload filters, bool showLoadingIndicator)
    {
        var includesVehicleLayer = filters.VisibleLayers.Any(layer =>
            string.Equals(layer, TileLayerNames.Cam, StringComparison.OrdinalIgnoreCase)
            || string.Equals(layer, TileLayerNames.Denm, StringComparison.OrdinalIgnoreCase));

        if (!includesVehicleLayer)
        {
            filteredDistinctVehicleCount = 0;
            vehicleSummaryScopeLabel = useCenterTileScope ? "Tile" : "Viewport";
            vehicleSummaryErrorMessage = null;
            stationTypeShares.Clear();
            StateHasChanged();
            return;
        }

        vehicleSummaryRefreshCts?.Cancel();
        vehicleSummaryRefreshCts?.Dispose();
        vehicleSummaryRefreshCts = new CancellationTokenSource();

        if (showLoadingIndicator)
        {
            isVehicleSummaryLoading = true;
            StateHasChanged();
        }

        try
        {
            var viewBounds = await JS.InvokeAsync<MapViewportBoundsPayload?>("v2xMap.getCurrentViewBounds");
            var requestUri = BuildVehicleSummaryRequestUri(filters, viewBounds, useCenterTileScope);
            var summary = await Http.GetFromJsonAsync<MapVehicleFilterSummaryDto>(requestUri, vehicleSummaryRefreshCts.Token);

            filteredDistinctVehicleCount = summary?.DistinctVehicleCount ?? 0;
            vehicleSummaryScopeLabel = string.IsNullOrWhiteSpace(summary?.Scope) ? "Global" : summary.Scope;
            vehicleSummaryErrorMessage = null;
            stationTypeShares = summary?.StationTypeShares
                ?.OrderBy(share => share.StationType)
                .ToList() ?? new List<StationTypeShareDto>();
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            vehicleSummaryErrorMessage = $"Vehicle counter refresh failed: {ex.Message}";
        }
        finally
        {
            if (showLoadingIndicator)
            {
                isVehicleSummaryLoading = false;
            }

            StateHasChanged();
        }
    }

    private static string BuildVehicleSummaryRequestUri(TileFilterPayload filters, MapViewportBoundsPayload? viewBounds, bool useTileScope)
    {
        var queryParams = new List<string>();

        foreach (var layer in filters.VisibleLayers)
        {
            AddQueryParam(queryParams, "visibleLayers", layer);
        }

        AddQueryParam(queryParams, "fromTime", filters.FromTime);
        AddQueryParam(queryParams, "toTime", filters.ToTime);
        AddQueryParam(queryParams, "isSecureSigned", filters.IsSecureSigned?.ToString()?.ToLowerInvariant());
        AddQueryParam(queryParams, "isSecureEncrypted", filters.IsSecureEncrypted?.ToString()?.ToLowerInvariant());

        foreach (var stationType in filters.StationTypes)
        {
            AddQueryParam(queryParams, "stationTypes", stationType.ToString());
        }

        foreach (var vehicleRole in filters.VehicleRoles)
        {
            AddQueryParam(queryParams, "vehicleRoles", vehicleRole);
        }

        if (viewBounds is not null)
        {
            if (useTileScope)
            {
                AddQueryParam(queryParams, "tileZ", viewBounds.TileZ.ToString(System.Globalization.CultureInfo.InvariantCulture));
                AddQueryParam(queryParams, "tileX", viewBounds.TileX.ToString(System.Globalization.CultureInfo.InvariantCulture));
                AddQueryParam(queryParams, "tileY", viewBounds.TileY.ToString(System.Globalization.CultureInfo.InvariantCulture));
            }
            else
            {
                AddQueryParam(queryParams, "minLatitude", viewBounds.MinLatitude.ToString("R", System.Globalization.CultureInfo.InvariantCulture));
                AddQueryParam(queryParams, "maxLatitude", viewBounds.MaxLatitude.ToString("R", System.Globalization.CultureInfo.InvariantCulture));
                AddQueryParam(queryParams, "minLongitude", viewBounds.MinLongitude.ToString("R", System.Globalization.CultureInfo.InvariantCulture));
                AddQueryParam(queryParams, "maxLongitude", viewBounds.MaxLongitude.ToString("R", System.Globalization.CultureInfo.InvariantCulture));
            }
        }

        if (queryParams.Count == 0)
        {
            return "api/map/vehicles/summary";
        }

        return $"api/map/vehicles/summary?{string.Join("&", queryParams)}";
    }

    private static void AddQueryParam(List<string> queryParams, string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        queryParams.Add($"{Uri.EscapeDataString(key)}={Uri.EscapeDataString(value)}");
    }

    private static string GetStationTypeLabel(int stationType)
    {
        return StationTypeLabelsByValue.TryGetValue(stationType, out var label)
            ? label
            : $"{stationType} - Other";
    }

    private void StartDiagnosticsPolling()
    {
        diagnosticsPollingCts?.Cancel();
        diagnosticsPollingCts?.Dispose();

        diagnosticsPollingCts = new CancellationTokenSource();
        diagnosticsPollingTask = PollTileCacheDiagnosticsAsync(diagnosticsPollingCts.Token);
    }

    private async Task PollTileCacheDiagnosticsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));

        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            if (!isInitialized || isLoading)
            {
                continue;
            }

            try
            {
                var diagnostics = await Http.GetFromJsonAsync<TileCacheDiagnosticsDto>(
                    "api/tiles/diagnostics/cache",
                    cancellationToken);

                if (diagnostics?.LayerGenerations is null || diagnostics.LayerGenerations.Count == 0)
                {
                    continue;
                }

                var fingerprint = BuildDiagnosticsFingerprint(diagnostics.LayerGenerations);
                if (string.IsNullOrWhiteSpace(lastDiagnosticsFingerprint))
                {
                    lastDiagnosticsFingerprint = fingerprint;
                    continue;
                }

                if (string.Equals(lastDiagnosticsFingerprint, fingerprint, StringComparison.Ordinal))
                {
                    continue;
                }

                lastDiagnosticsFingerprint = fingerprint;
                await JS.InvokeVoidAsync("v2xMap.forceRefreshTiles");
            }
            catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // Diagnostics endpoint can be disabled outside development/feature-flag scenarios.
                continue;
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                // Keep polling resilient; map interaction should continue even if diagnostics checks fail.
            }
        }
    }

    private static string BuildDiagnosticsFingerprint(IReadOnlyDictionary<string, int> layerGenerations)
    {
        return string.Join(
            "|",
            layerGenerations
                .OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)
                .Select(pair => $"{pair.Key}:{pair.Value}"));
    }

    public async ValueTask DisposeAsync()
    {
        if (diagnosticsPollingCts is not null)
        {
            await diagnosticsPollingCts.CancelAsync();
            diagnosticsPollingCts.Dispose();
            diagnosticsPollingCts = null;
        }

        if (diagnosticsPollingTask is not null)
        {
            try
            {
                await diagnosticsPollingTask;
            }
            catch
            {
            }

            diagnosticsPollingTask = null;
        }

        vehicleSummaryRefreshCts?.Cancel();
        vehicleSummaryRefreshCts?.Dispose();
        vehicleSummaryRefreshCts = null;

        mapDotNetReference?.Dispose();
        mapDotNetReference = null;

        try
        {
            await JS.InvokeVoidAsync("v2xMap.unregisterViewportChangedCallback");
            await JS.InvokeVoidAsync("v2xMap.disposeMap");
        }
        catch
        {
        }
    }
}
