@page "/map"
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Map</PageTitle>

<MudContainer Style="height: 100%;" MaxWidth="MaxWidth.False" Class="map-page">
    <MudStack Spacing="3">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@errorMessage</MudAlert>
        }       

        <MudPaper Class="panel-card" Elevation="0" Height="30%">            
            <MudStack Row="true" Spacing="1" Class="map-legend-row">
                <MudChip T="string" Class="legend-chip legend-chip-cam">CAM</MudChip>
                <MudChip T="string" Class="legend-chip legend-chip-srem">SREM Request</MudChip>
                <MudChip T="string" Class="legend-chip legend-chip-denm">DENM Event</MudChip>
                <MudChip T="string" Class="legend-chip legend-chip-ssem">SSEM Status</MudChip>
                <MudChip T="string" Class="legend-chip legend-chip-mapem">MAPEM</MudChip>
                <MudChip T="string" Class="legend-chip legend-chip-spatem">SPATEM</MudChip>
            </MudStack>
            <MudGrid Spacing="2"  Justify="Justify.FlexEnd">
                <MudItem xs="12" md="6" lg="3" >
                    <MudTextField T="string" Label="From" Variant="Variant.Outlined" InputType="InputType.DateTimeLocal" @bind-Value="fromTimeText" />
                </MudItem>
                <MudItem xs="12" md="6" lg="3">
                    <MudTextField T="string" Label="To" Variant="Variant.Outlined" InputType="InputType.DateTimeLocal" @bind-Value="toTimeText" />
                </MudItem>
                <MudItem xs="12" md="6" lg="6" Style="align-self: flex-end;">
                    <MudText Typo="Typo.subtitle2">Entity Filter</MudText>
                    <MudStack Row="true" Spacing="2" Class="map-toggle-row">
                        <MudCheckBox @bind-Value="showObu" Label="OBU" Color="Color.Primary" />
                        <MudCheckBox @bind-Value="showRsu" Label="RSU" Color="Color.Primary" />
                        <MudCheckBox @bind-Value="showCorrelations" Label="Correlations" Color="Color.Success" />
                        <MudCheckBox @bind-Value="showSecureSigned" Label="Secure: Signed" Color="Color.Info" />
                        <MudCheckBox @bind-Value="showSecureEncrypted" Label="Secure: Encrypted" Color="Color.Info" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="6" lg="6" >
                    <MudStack>
                        <MudItem xs="12" md="6" lg="4">
                        <MudText Typo="Typo.subtitle2" Class="mt-3">Vehicle Category</MudText>
                        <MudStack Row="true" " Class="map-filter-checkbox-row">
                            @foreach (var category in availableVehicleCategories)
                            {
                                <MudCheckBox T="string"
                                             @key="category"
                                             Value="category"
                                             Checked="@selectedVehicleCategories.Contains(category)"
                                             CheckedChanged="@((bool isChecked) => OnVehicleCategoryToggled(category, isChecked))"
                                             Label="@category"
                                             Color="Color.Primary"
                                             Disabled="@isLoading" />
                            }
                        </MudStack>
                        </MudItem>
                        <MudItem xs="12" md="6" lg="4">
                        <MudText Typo="Typo.subtitle2" Class="mt-3">Station Type</MudText>
                        <MudStack Row="true"  Class="map-filter-checkbox-row">
                            @foreach (var stationType in availableStationTypes)
                            {
                                <MudCheckBox T="int"
                                             @key="stationType"
                                             Value="stationType"
                                             Checked="@selectedStationTypes.Contains(stationType)"
                                             CheckedChanged="@((bool isChecked) => OnStationTypeToggled(stationType, isChecked))"
                                             Label="@GetStationTypeLabel(stationType)"
                                             Color="Color.Primary"
                                             Disabled="@isLoading" />
                            }
                        </MudStack>
                        </MudItem>
                    </MudStack>

                </MudItem>
                <MudItem xs="12" md="6" lg="6">
                    <MudText Typo="Typo.subtitle2">Message Type Filter</MudText>
                    <MudStack Row="true" Class="map-toggle-row">
                        <MudCheckBox @bind-Value="showCam" Label="CAM" Color="Color.Success" />
                        <MudCheckBox @bind-Value="showSrem" Label="SREM" Color="Color.Secondary" />
                        <MudCheckBox @bind-Value="showDenm" Label="DENM" Color="Color.Error" />
                        <MudCheckBox @bind-Value="showSsem" Label="SSEM" Color="Color.Warning" />
                        <MudCheckBox @bind-Value="showMapem" Label="MAPEM" Color="Color.Info" />
                        <MudCheckBox @bind-Value="showSpatem" Label="SPATEM" Color="Color.Primary" />
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="6" lg="4" Style="align-self: flex-end;">
                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Class="map-toolbar-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadDataAsync" Disabled="@isLoading">Apply Filters</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ApplyClientFiltersAsync" Disabled="@isLoading">Refresh View</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="RecordCorrelationsAsync" Disabled="@isLoading">Rebuild Correlations</MudButton>
                    </MudStack>
                </MudItem>  
            </MudGrid>
        </MudPaper>

        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        <MudPaper Class="map-shell" Elevation="0" Height="70%">
            <div id="v2x-map" class="map-canvas"></div>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private static readonly Dictionary<int, string> StationTypeNames = new()
    {
        [0] = "Unknown",
        [1] = "Pedestrian",
        [2] = "Cyclist",
        [3] = "Moped",
        [4] = "Motorcycle",
        [5] = "Passenger Car",
        [6] = "Bus",
        [7] = "Light Truck",
        [8] = "Heavy Truck",
        [9] = "Trailer",
        [10] = "Special Vehicle",
        [11] = "Tram",
        [15] = "RSU"
    };

    private static readonly Dictionary<int, string> VehicleRoleNames = new()
    {
        [0] = "0",
        [1] = "Public Transport",
        [2] = "Special Transport",
        [3] = "Dangerous Goods",
        [4] = "Road Work",
        [5] = "Rescue",
        [6] = "Emergency",
        [7] = "Safety Car",
        [8] = "Agriculture",
        [9] = "Commercial",
        [10] = "Military",
        [11] = "Road Operator",
        [12] = "Taxi"
    };
    private bool isInitialized;
    private DateTime? fromTimeValue;
    private DateTime? toTimeValue;
    private string? fromTimeText;
    private string? toTimeText;
    private bool showObu = true;
    private bool showRsu = true;
    private bool showCorrelations = true;
    private bool showSecureSigned = true;
    private bool showSecureEncrypted = true;
    private bool showCam = true;
    private bool showSrem = true;
    private bool showDenm = true;
    private bool showSsem = true;
    private bool showMapem = true;
    private bool showSpatem = true;
    private bool isLoading;
    private int entityCount;
    private int correlationCount;
    private int entityGridPageNumber = 1;
    private const int EntityGridPageSize = 100;
    private int entityGridTotalCount;
    private int correlationGridPageNumber = 1;
    private const int CorrelationGridPageSize = 100;
    private int correlationGridTotalCount;
    private DateTime? lastUpdatedUtc;
    private string? errorMessage;
    private List<MapEntityDto> allEntities = new();
    private List<MapEntityDto> mapVisibleEntities = new();
    private List<MapEntityDto> entityGridItems = new();
    private List<CorrelationDto> allCorrelations = new();
    private List<CorrelationDto> mapVisibleCorrelations = new();
    private List<CorrelationDto> correlationGridItems = new();
    private List<string> availableVehicleCategories = new();
    private HashSet<string> selectedVehicleCategories = new(StringComparer.OrdinalIgnoreCase);
    private List<int> availableStationTypes = new();
    private HashSet<int> selectedStationTypes = new();
    private int EntityGridTotalPages => Math.Max(1, (int)Math.Ceiling(entityGridTotalCount / (double)EntityGridPageSize));
    private int CorrelationGridTotalPages => Math.Max(1, (int)Math.Ceiling(correlationGridTotalCount / (double)CorrelationGridPageSize));
    private string lastUpdatedLabel => lastUpdatedUtc.HasValue
        ? lastUpdatedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        : "never";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var config = await Http.GetFromJsonAsync<MapConfigDto>("api/map/config");
            if (config is null)
            {
                errorMessage = "Map configuration could not be loaded.";
                StateHasChanged();
                return;
            }

            await JS.InvokeVoidAsync("v2xMap.initializeMap",
                "v2x-map",
                config.TileStyleUrl,
                config.DefaultCenterLongitude,
                config.DefaultCenterLatitude,
                config.DefaultZoom,
                config.MinZoom,
                config.MaxZoom);

            isInitialized = true;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Map initialization failed: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        if (!isInitialized)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            fromTimeValue = ParseLocalDateTime(fromTimeText);
            toTimeValue = ParseLocalDateTime(toTimeText);

            var fromTime = fromTimeValue;
            var toTime = toTimeValue;
            var secureSignedFilter = ResolveSecureSignedFilter();
            var secureEncryptedFilter = ResolveSecureEncryptedFilter();

            var entitiesUrl = BuildMapEntitiesUrl(fromTime, toTime);
            var correlationsUrl = BuildCorrelationsUrl(fromTime, toTime, secureSignedFilter, secureEncryptedFilter, 2000);

            allEntities = await Http.GetFromJsonAsync<List<MapEntityDto>>(entitiesUrl) ?? new List<MapEntityDto>();
            allCorrelations = await Http.GetFromJsonAsync<List<CorrelationDto>>(correlationsUrl) ?? new List<CorrelationDto>();
            RefreshVehicleCategories();
            RefreshStationTypes();
            await ApplyClientFiltersAsync();
            lastUpdatedUtc = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load map data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyClientFiltersAsync()
    {
        if (!isInitialized)
        {
            return;
        }

        var filteredEntities = allEntities
            .Where(e =>
                (showObu && string.Equals(e.EntityType, "OBU", StringComparison.OrdinalIgnoreCase)) ||
                (showRsu && string.Equals(e.EntityType, "RSU", StringComparison.OrdinalIgnoreCase)) ||
                (showDenm && string.Equals(e.EntityType, "EVENT", StringComparison.OrdinalIgnoreCase)))
            .Where(e =>
                (showCam && e.MessageType == "CAM") ||
                (showSrem && e.MessageType == "SREM") ||
                (showDenm && e.MessageType == "DENM") ||
                (showSsem && e.MessageType == "SSEM") ||
                (showMapem && e.MessageType == "MAPEM") ||
                (showSpatem && e.MessageType == "SPATEM"))
            .Where(e => IsVehicleCategorySelected(e))
            .Where(e => IsStationTypeSelected(e))
            .Where(e => PassesSecurityFilter(e.IsSecureSigned, e.IsSecureEncrypted))
            .ToList();

        var filteredCorrelations = showCorrelations
            ? allCorrelations.Where(c => PassesSecurityFilter(c.IsSecureSigned, c.IsSecureEncrypted)).ToList()
            : new List<CorrelationDto>();

        mapVisibleEntities = filteredEntities;
        mapVisibleCorrelations = filteredCorrelations;

        await JS.InvokeVoidAsync("v2xMap.setEntities", mapVisibleEntities);
        await JS.InvokeVoidAsync("v2xMap.setCorrelations", mapVisibleCorrelations);

        entityCount = mapVisibleEntities.Count;
        correlationCount = mapVisibleCorrelations.Count;

        await LoadEntityGridPageAsync(1);
        await LoadCorrelationGridPageAsync(1);
    }

    private async Task LoadEntityGridPageAsync(int pageNumber)
    {
        var url = BuildPagedMapEntitiesUrl(
            fromTimeValue,
            toTimeValue,
            BuildSelectedEntityTypes(),
            BuildSelectedMessageTypes(),
            selectedVehicleCategories,
            selectedStationTypes,
            ResolveSecureSignedFilter(),
            ResolveSecureEncryptedFilter(),
            pageNumber,
            EntityGridPageSize);

        var pagedResult = await Http.GetFromJsonAsync<PagedResult<MapEntityDto>>(url) ?? new PagedResult<MapEntityDto>();

        entityGridItems = pagedResult.Items.ToList();
        entityGridPageNumber = pagedResult.PageNumber <= 0 ? pageNumber : pagedResult.PageNumber;
        entityGridTotalCount = pagedResult.TotalCount;
    }

    private async Task LoadCorrelationGridPageAsync(int pageNumber)
    {
        if (!showCorrelations)
        {
            correlationGridItems = new List<CorrelationDto>();
            correlationGridPageNumber = 1;
            correlationGridTotalCount = 0;
            return;
        }

        var url = BuildPagedCorrelationsUrl(
            fromTimeValue,
            toTimeValue,
            ResolveSecureSignedFilter(),
            ResolveSecureEncryptedFilter(),
            pageNumber,
            CorrelationGridPageSize);
        var pagedResult = await Http.GetFromJsonAsync<PagedResult<CorrelationDto>>(url) ?? new PagedResult<CorrelationDto>();

        correlationGridItems = pagedResult.Items.ToList();
        correlationGridPageNumber = pagedResult.PageNumber <= 0 ? pageNumber : pagedResult.PageNumber;
        correlationGridTotalCount = pagedResult.TotalCount;
    }

    private Task PreviousEntityGridPageAsync() => entityGridPageNumber > 1
        ? LoadEntityGridPageAsync(entityGridPageNumber - 1)
        : Task.CompletedTask;

    private Task NextEntityGridPageAsync() => entityGridPageNumber < EntityGridTotalPages
        ? LoadEntityGridPageAsync(entityGridPageNumber + 1)
        : Task.CompletedTask;

    private Task PreviousCorrelationGridPageAsync() => correlationGridPageNumber > 1
        ? LoadCorrelationGridPageAsync(correlationGridPageNumber - 1)
        : Task.CompletedTask;

    private Task NextCorrelationGridPageAsync() => correlationGridPageNumber < CorrelationGridTotalPages
        ? LoadCorrelationGridPageAsync(correlationGridPageNumber + 1)
        : Task.CompletedTask;

    private void RefreshVehicleCategories()
    {
        var categories = allEntities
            .Where(static entity => string.Equals(entity.EntityType, "OBU", StringComparison.OrdinalIgnoreCase))
            .Select(GetVehicleCategory)
            .Where(static category => !string.IsNullOrWhiteSpace(category))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(static category => category)
            .ToList();

        availableVehicleCategories = categories;

        if (selectedVehicleCategories.Count == 0)
        {
            selectedVehicleCategories = categories.ToHashSet(StringComparer.OrdinalIgnoreCase);
            return;
        }

        selectedVehicleCategories = selectedVehicleCategories
            .Where(selected => categories.Contains(selected, StringComparer.OrdinalIgnoreCase))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (selectedVehicleCategories.Count == 0)
        {
            selectedVehicleCategories = categories.ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
    }

    private void RefreshStationTypes()
    {
        var stationTypes = allEntities
            .Where(entity => entity.StationType.HasValue)
            .Select(entity => entity.StationType!.Value)
            .Distinct()
            .OrderBy(value => value)
            .ToList();

        availableStationTypes = stationTypes;

        if (selectedStationTypes.Count == 0)
        {
            selectedStationTypes = stationTypes.ToHashSet();
            return;
        }

        selectedStationTypes = selectedStationTypes
            .Where(selected => stationTypes.Contains(selected))
            .ToHashSet();

        if (selectedStationTypes.Count == 0)
        {
            selectedStationTypes = stationTypes.ToHashSet();
        }
    }

    private async Task OnVehicleCategoryToggled(string category, bool isChecked)
    {
        if (isChecked)
        {
            selectedVehicleCategories.Add(category);
        }
        else
        {
            selectedVehicleCategories.Remove(category);
        }
        await ApplyClientFiltersAsync();
    }

    private async Task OnStationTypeToggled(int stationType, bool isChecked)
    {
        if (isChecked)
        {
            selectedStationTypes.Add(stationType);
        }
        else
        {
            selectedStationTypes.Remove(stationType);
        }
        await ApplyClientFiltersAsync();
    }

    private bool IsVehicleCategorySelected(MapEntityDto entity)
    {
        if (!string.Equals(entity.EntityType, "OBU", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (selectedVehicleCategories.Count == 0)
        {
            return true;
        }

        var category = GetVehicleCategory(entity);
        return selectedVehicleCategories.Contains(category);
    }

    private bool IsStationTypeSelected(MapEntityDto entity)
    {
        if (selectedStationTypes.Count == 0)
        {
            return true;
        }

        if (!entity.StationType.HasValue)
        {
            return true;
        }

        return selectedStationTypes.Contains(entity.StationType.Value);
    }

    private static string GetVehicleCategory(MapEntityDto entity)
    {
        if (!string.IsNullOrWhiteSpace(entity.VehicleRole))
        {
            var normalizedRole = entity.VehicleRole.Trim();
            if (int.TryParse(normalizedRole, out var roleCode))
            {
                if (VehicleRoleNames.TryGetValue(roleCode, out var roleName))
                {
                    return roleName;
                }

                return roleCode == 0
                    ? "Unknown"
                    : $"Vehicle Role {roleCode}";
            }

            var loweredRole = normalizedRole.ToLowerInvariant();
            return loweredRole switch
            {
                "publictransport" => "Public Transport",
                "public_transport" => "Public Transport",
                "specialtransport" => "Special Transport",
                "dangerousgoods" => "Dangerous Goods",
                "roadwork" => "Road Work",
                "passengercar" => "Passenger Car",
                "lighttruck" => "Light Truck",
                "heavytruck" => "Heavy Truck",
                "roadsideunit" => "RSU",
                "emergency" => "Emergency Vehicle",
                _ => ToTitleWords(loweredRole)
            };
        }

        return entity.StationType.HasValue
            ? GetStationTypeName(entity.StationType.Value)
            : "Unknown";
    }

    private static string GetStationTypeName(int stationTypeCode)
        => StationTypeNames.TryGetValue(stationTypeCode, out var name)
            ? name
            : "Unknown";

    private static string GetStationTypeLabel(int stationTypeCode)
        => $"{stationTypeCode} - {GetStationTypeName(stationTypeCode)}";

    private static string ToTitleWords(string rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            return "Unknown";
        }

        var normalized = rawValue
            .Replace('_', ' ')
            .Replace('-', ' ');

        var parts = normalized.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        for (var index = 0; index < parts.Length; index++)
        {
            var part = parts[index];
            parts[index] = char.ToUpperInvariant(part[0]) + part[1..];
        }

        return string.Join(' ', parts);
    }

    private async Task RecordCorrelationsAsync()
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync("api/correlations/record", null);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = $"Correlation rebuild failed: {body}";
                return;
            }

            Snackbar.Add("Correlation records rebuilt.", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Correlation rebuild failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static string BuildMapEntitiesUrl(DateTime? fromTime, DateTime? toTime)
    {
        var queryParts = new List<string>();

        if (fromTime.HasValue)
        {
            queryParts.Add($"fromTime={Uri.EscapeDataString(fromTime.Value.ToString("O"))}");
        }

        if (toTime.HasValue)
        {
            queryParts.Add($"toTime={Uri.EscapeDataString(toTime.Value.ToString("O"))}");
        }

        return queryParts.Count == 0
            ? "api/map/entities"
            : $"api/map/entities?{string.Join("&", queryParts)}";
    }



    private static string BuildCorrelationsUrl(
        DateTime? fromTime,
        DateTime? toTime,
        bool? isSecureSigned,
        bool? isSecureEncrypted,
        int limit)
    {
        var queryParts = new List<string>();

        if (fromTime.HasValue)
        {
            queryParts.Add($"fromTime={Uri.EscapeDataString(fromTime.Value.ToString("O"))}");
        }

        if (toTime.HasValue)
        {
            queryParts.Add($"toTime={Uri.EscapeDataString(toTime.Value.ToString("O"))}");
        }

        if (isSecureSigned.HasValue)
        {
            queryParts.Add($"isSecureSigned={isSecureSigned.Value.ToString().ToLowerInvariant()}");
        }

        if (isSecureEncrypted.HasValue)
        {
            queryParts.Add($"isSecureEncrypted={isSecureEncrypted.Value.ToString().ToLowerInvariant()}");
        }

        queryParts.Add($"limit={limit}");
        return $"api/correlations?{string.Join("&", queryParts)}";
    }

    private static string BuildPagedCorrelationsUrl(
        DateTime? fromTime,
        DateTime? toTime,
        bool? isSecureSigned,
        bool? isSecureEncrypted,
        int pageNumber,
        int pageSize)
    {
        var queryParts = new List<string>
        {
            $"pageNumber={pageNumber}",
            $"pageSize={pageSize}"
        };

        if (fromTime.HasValue)
        {
            queryParts.Add($"fromTime={Uri.EscapeDataString(fromTime.Value.ToString("O"))}");
        }

        if (toTime.HasValue)
        {
            queryParts.Add($"toTime={Uri.EscapeDataString(toTime.Value.ToString("O"))}");
        }

        if (isSecureSigned.HasValue)
        {
            queryParts.Add($"isSecureSigned={isSecureSigned.Value.ToString().ToLowerInvariant()}");
        }

        if (isSecureEncrypted.HasValue)
        {
            queryParts.Add($"isSecureEncrypted={isSecureEncrypted.Value.ToString().ToLowerInvariant()}");
        }

        return $"api/correlations/paged?{string.Join("&", queryParts)}";
    }

    private static string BuildPagedMapEntitiesUrl(
        DateTime? fromTime,
        DateTime? toTime,
        IEnumerable<string> entityTypes,
        IEnumerable<string> messageTypes,
        IEnumerable<string> vehicleCategories,
        IEnumerable<int> stationTypes,
        bool? isSecureSigned,
        bool? isSecureEncrypted,
        int pageNumber,
        int pageSize)
    {
        var queryParts = new List<string>
        {
            $"pageNumber={pageNumber}",
            $"pageSize={pageSize}"
        };

        if (fromTime.HasValue)
        {
            queryParts.Add($"fromTime={Uri.EscapeDataString(fromTime.Value.ToString("O"))}");
        }

        if (toTime.HasValue)
        {
            queryParts.Add($"toTime={Uri.EscapeDataString(toTime.Value.ToString("O"))}");
        }

        foreach (var entityType in entityTypes)
        {
            queryParts.Add($"entityTypes={Uri.EscapeDataString(entityType)}");
        }

        foreach (var messageType in messageTypes)
        {
            queryParts.Add($"messageTypes={Uri.EscapeDataString(messageType)}");
        }

        foreach (var vehicleCategory in vehicleCategories)
        {
            queryParts.Add($"vehicleCategories={Uri.EscapeDataString(vehicleCategory)}");
        }

        foreach (var stationType in stationTypes)
        {
            queryParts.Add($"stationTypes={stationType}");
        }

        if (isSecureSigned.HasValue)
        {
            queryParts.Add($"isSecureSigned={isSecureSigned.Value.ToString().ToLowerInvariant()}");
        }

        if (isSecureEncrypted.HasValue)
        {
            queryParts.Add($"isSecureEncrypted={isSecureEncrypted.Value.ToString().ToLowerInvariant()}");
        }

        return $"api/map/entities/paged?{string.Join("&", queryParts)}";
    }

    private bool PassesSecurityFilter(bool isSecureSignedValue, bool isSecureEncryptedValue)
    {
        var signedFilter = ResolveSecureSignedFilter();
        var encryptedFilter = ResolveSecureEncryptedFilter();

        if (signedFilter.HasValue && isSecureSignedValue != signedFilter.Value)
        {
            return false;
        }

        if (encryptedFilter.HasValue && isSecureEncryptedValue != encryptedFilter.Value)
        {
            return false;
        }

        return true;
    }

    private bool? ResolveSecureSignedFilter()
    {
        if (showSecureSigned && showSecureEncrypted)
        {
            return null;
        }

        return showSecureSigned;
    }

    private bool? ResolveSecureEncryptedFilter()
    {
        if (showSecureSigned && showSecureEncrypted)
        {
            return null;
        }

        return showSecureEncrypted;
    }

    private IEnumerable<string> BuildSelectedEntityTypes()
    {
        if (showObu)
        {
            yield return "OBU";
        }

        if (showRsu)
        {
            yield return "RSU";
        }

        if (showDenm)
        {
            yield return "EVENT";
        }
    }

    private IEnumerable<string> BuildSelectedMessageTypes()
    {
        if (showCam)
        {
            yield return "CAM";
        }

        if (showSrem)
        {
            yield return "SREM";
        }

        if (showDenm)
        {
            yield return "DENM";
        }

        if (showSsem)
        {
            yield return "SSEM";
        }

        if (showMapem)
        {
            yield return "MAPEM";
        }

        if (showSpatem)
        {
            yield return "SPATEM";
        }
    }

    private static DateTime? ParseLocalDateTime(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        return DateTime.TryParse(value, out var parsed) ? parsed : null;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("v2xMap.disposeMap");
        }
        catch
        {
            // Ignore disposal errors during navigation or app shutdown.
        }
    }
}
