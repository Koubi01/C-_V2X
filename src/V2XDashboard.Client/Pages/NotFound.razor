@page "/not-found"
@layout MainLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="not-found-page">
	<MudPaper Class="panel-card" Elevation="0">
		<MudText Typo="Typo.h4">Page not found</MudText>
		<MudText Typo="Typo.body1" Class="mt-2">The requested route is not available in this dashboard.</MudText>
		<MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Href="">Return to dashboard</MudButton>
	</MudPaper>
</MudContainer>