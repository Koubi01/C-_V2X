@page "/packets"
@inject HttpClient Http

<PageTitle>Packets</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="data-page">
    <MudStack Spacing="3">
        <MudPaper Class="panel-card" Elevation="0">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h4">Packet Explorer</MudText>
                    <MudText Typo="Typo.body1">Query decoded packets by protocol or message family and inspect the latest traffic sample.</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Filter" Variant="Variant.Outlined" Placeholder="CAM, 802.11p, DENM..." @bind-Value="filter" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField T="int" Label="Page Size" Variant="Variant.Outlined" Min="5" Max="200" @bind-Value="pageSize" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="ApplyFiltersAsync" Disabled="@isLoading">Load</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@errorMessage</MudAlert>
        }

        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }

        <MudPaper Class="panel-card" Elevation="0">
            <MudTable Items="packets" Dense="true" Hover="true" Breakpoint="Breakpoint.Md">
                <HeaderContent>
                    <MudTh>Timestamp</MudTh>
                    <MudTh>Packet Type</MudTh>
                    <MudTh>Protocol</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh>Destination</MudTh>
                    <MudTh>Length</MudTh>
                    <MudTh>PCAP</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Timestamp">@context.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                    <MudTd DataLabel="Packet Type">@context.PacketType</MudTd>
                    <MudTd DataLabel="Source">@FormatEndpoint( context.SourcePort, context.SourceMac)</MudTd>
                    <MudTd DataLabel="Destination">@FormatEndpoint( context.DestinationPort, context.DestinationMac)</MudTd>
                    <MudTd DataLabel="Length">@context.Length B</MudTd>
                    <MudTd DataLabel="PCAP">@context.PcapFileName</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4">No packets matched the current filter.</MudText>
                </NoRecordsContent>
            </MudTable>

            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="table-pager-row mt-3">
                <MudText Typo="Typo.body2">Page @pageNumber of @TotalPages (@totalCount packets)</MudText>
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="PreviousPageAsync" Disabled="@(isLoading || pageNumber <= 1)">Previous</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="NextPageAsync" Disabled="@(isLoading || pageNumber >= TotalPages)">Next</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private readonly List<Packet> packets = new();
    private bool isLoading;
    private string filter = string.Empty;
    private int pageNumber = 1;
    private int pageSize = 25;
    private int totalCount;
    private string? errorMessage;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)Math.Max(1, pageSize)));

    protected override async Task OnInitializedAsync()
    {
        await LoadPacketsAsync(pageNumber);
    }

    private async Task ApplyFiltersAsync()
    {
        await LoadPacketsAsync(1);
    }

    private async Task PreviousPageAsync()
    {
        if (pageNumber > 1)
        {
            await LoadPacketsAsync(pageNumber - 1);
        }
    }

    private async Task NextPageAsync()
    {
        if (pageNumber < TotalPages)
        {
            await LoadPacketsAsync(pageNumber + 1);
        }
    }

    private async Task LoadPacketsAsync(int targetPage)
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var queryParts = new List<string>
            {
                $"pageNumber={targetPage}",
                $"pageSize={pageSize}"
            };

            if (!string.IsNullOrWhiteSpace(filter))
            {
                queryParts.Add($"filter={Uri.EscapeDataString(filter)}");
            }

            var url = $"api/pcap/packets/paged?{string.Join("&", queryParts)}";
            var result = await Http.GetFromJsonAsync<PagedResult<Packet>>(url) ?? new PagedResult<Packet>();

            packets.Clear();
            packets.AddRange(result.Items.OrderByDescending(packet => packet.Timestamp));
            totalCount = result.TotalCount;
            pageNumber = result.PageNumber <= 0 ? targetPage : result.PageNumber;
        }
        catch (Exception ex)
        {
            errorMessage = $"Packet query failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatEndpoint(int port, string macAddress)
    {
          return string.IsNullOrWhiteSpace(macAddress) ? "n/a" : macAddress;
    }
}
