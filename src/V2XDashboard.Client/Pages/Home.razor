@page "/"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" style="max-height: 100%;" Class="dashboard-page">
	<MudStack Spacing="3">
		<MudPaper Class="dashboard-hero" Elevation="1">
			<MudGrid Spacing="3">
				<MudItem xs="12" md="7">
					<MudText Typo="Typo.h3">V2X PCAP Dashboard</MudText>
				</MudItem>
				<MudItem xs="12" md="5">
					<MudPaper Class="hero-actions" Elevation="0">
						<MudStack Spacing="2">
							<MudSelect T="string" Label="PCAP file" Variant="Variant.Outlined" @bind-Value="selectedFile" Disabled="@isBusy">
								@foreach (var file in pcapFiles)
								{
									<MudSelectItem T="string" Value="@file">@file</MudSelectItem>
								}
							</MudSelect>
							<MudStack Row="true" Spacing="2">
								<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ProcessSelectedFileAsync" Disabled="@(isBusy || string.IsNullOrWhiteSpace(selectedFile))">
									Process Selected
								</MudButton>
								<MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ProcessAllFilesAsync" Disabled="@isBusy">
									Process All
								</MudButton>
								<MudButton Variant="Variant.Text" OnClick="LoadDashboardAsync" Disabled="@isBusy">
									Refresh
								</MudButton>
							</MudStack>
						</MudStack>
					</MudPaper>
				</MudItem>
			</MudGrid>
		</MudPaper>

		@if (!string.IsNullOrWhiteSpace(errorMessage))
		{
			<MudAlert Severity="Severity.Error" Variant="Variant.Filled">@errorMessage</MudAlert>
		}

		@if (isLoading)
		{
			<MudProgressLinear Indeterminate="true" Color="Color.Primary" />
		}

		<MudGrid Spacing="2">
			<MudItem xs="12" sm="6" lg="3">
				<MudPaper Class="metric-card" Elevation="0">
					<MudText Typo="Typo.overline">Available Files</MudText>
					<MudText Typo="Typo.h3">@pcapFiles.Count</MudText>
					<MudText Typo="Typo.body2">Capture files ready for ingestion.</MudText>
				</MudPaper>
			</MudItem>
			<MudItem xs="12" sm="6" lg="3">
				<MudPaper Class="metric-card" Elevation="0">
					<MudText Typo="Typo.overline">Total Packets</MudText>
					<MudText Typo="Typo.h3">@totalPacketCount</MudText>
					<MudText Typo="Typo.body2">Packets stored in the database.</MudText>
				</MudPaper>
			</MudItem>
			<MudItem xs="12" sm="6" lg="3">
				<MudPaper Class="metric-card" Elevation="0">
					<MudText Typo="Typo.overline">Map Entities</MudText>
					<MudText Typo="Typo.h3">@entityCount</MudText>
					<MudText Typo="Typo.body2">Objects currently returned for map rendering.</MudText>
				</MudPaper>
			</MudItem>
			<MudItem xs="12" sm="6" lg="3">
				<MudPaper Class="metric-card" Elevation="0">
					<MudText Typo="Typo.overline">Correlations</MudText>
					<MudText Typo="Typo.h3">@correlationCount</MudText>
					<MudText Typo="Typo.body2">Recent OBU to RSU matches available to review.</MudText>
				</MudPaper>
			</MudItem>
		</MudGrid>

		<MudGrid Spacing="2">
			<MudItem xs="12">
				<MudPaper Class="panel-card" Elevation="0">
					<MudStack Row="true" Justify="Justify.SpaceBetween">
						<MudText Typo="Typo.h6">Message Families</MudText>
					</MudStack>
					<MudTable Items="messageSummaryRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="mt-3">
						<HeaderContent>
							<MudTh>Type</MudTh>
							<MudTh>Count</MudTh>
							<MudTh>Description</MudTh>
						</HeaderContent>
						<RowTemplate>
							<MudTd DataLabel="Type">
								<MudChip T="string" Color="@context.Color" Variant="Variant.Filled">@context.Name</MudChip>
							</MudTd>
							<MudTd DataLabel="Count">@context.Count</MudTd>
							<MudTd DataLabel="Description">@context.Description</MudTd>
						</RowTemplate>
					</MudTable>
				</MudPaper>
			</MudItem>
		</MudGrid>
	</MudStack>
</MudContainer>

@code {
	private readonly List<MessageSummaryRow> messageSummaryRows = new();
	private readonly List<string> pcapFiles = new();
	private bool isLoading;
	private bool isBusy;
	private int entityCount;
	private int correlationCount;
	private int totalPacketCount;
	private string? selectedFile;
	private string? errorMessage;

	protected override async Task OnInitializedAsync()
	{
		await LoadDashboardAsync();
	}

	private async Task LoadDashboardAsync()
	{
		isLoading = true;
		errorMessage = null;

		try
		{
			var filesTask   = Http.GetFromJsonAsync<List<string>>("api/ingestion/files");
			var countsTask  = Http.GetFromJsonAsync<MessageCountsDto>("api/messages/counts");
			var entitiesTask = Http.GetFromJsonAsync<List<MapEntityDto>>("api/map/entities");

			await Task.WhenAll(filesTask, countsTask, entitiesTask);

			pcapFiles.Clear();
			pcapFiles.AddRange((await filesTask) ?? new List<string>());
			selectedFile ??= pcapFiles.FirstOrDefault();

			var counts = await countsTask ?? new MessageCountsDto();
			totalPacketCount  = counts.TotalPackets;
			entityCount       = (await entitiesTask ?? new List<MapEntityDto>()).Count;
			correlationCount  = counts.TotalCorrelations;

			messageSummaryRows.Clear();
			messageSummaryRows.Add(new MessageSummaryRow("CAM",    counts.CAM,    Color.Success,   "Cooperative awareness from OBUs."));
			messageSummaryRows.Add(new MessageSummaryRow("DENM",   counts.DENM,   Color.Error,     "Safety and hazard notifications."));
			messageSummaryRows.Add(new MessageSummaryRow("MAPEM",  counts.MAPEM,  Color.Info,      "RSU map and lane topology."));
			messageSummaryRows.Add(new MessageSummaryRow("SPATEM", counts.SPATEM, Color.Warning,   "Signal phase and timing state."));
			messageSummaryRows.Add(new MessageSummaryRow("SREM",   counts.SREM,   Color.Secondary, "Priority requests from vehicles."));
			messageSummaryRows.Add(new MessageSummaryRow("SSEM",   counts.SSEM,   Color.Dark,      "Signal status and acknowledgements."));
		}
		catch (Exception ex)
		{
			errorMessage = $"Dashboard data could not be loaded: {ex.Message}";
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task ProcessSelectedFileAsync()
	{
		if (string.IsNullOrWhiteSpace(selectedFile) || isBusy)
		{
			return;
		}

		isBusy = true;
		errorMessage = null;

		try
		{
			var response = await Http.PostAsync($"api/ingestion/process/{Uri.EscapeDataString(selectedFile)}", null);
			if (!response.IsSuccessStatusCode)
			{
				errorMessage = await response.Content.ReadAsStringAsync();
				return;
			}

			Snackbar.Add($"Processed {selectedFile}", Severity.Success);
			await LoadDashboardAsync();
		}
		catch (Exception ex)
		{
			errorMessage = $"PCAP processing failed: {ex.Message}";
		}
		finally
		{
			isBusy = false;
		}
	}

	private async Task ProcessAllFilesAsync()
	{
		if (isBusy)
		{
			return;
		}

		isBusy = true;
		errorMessage = null;

		try
		{
			var response = await Http.PostAsync("api/ingestion/process/all", null);
			if (!response.IsSuccessStatusCode)
			{
				errorMessage = await response.Content.ReadAsStringAsync();
				return;
			}

			Snackbar.Add("All PCAP files processed.", Severity.Success);
			await LoadDashboardAsync();
		}
		catch (Exception ex)
		{
			errorMessage = $"Bulk processing failed: {ex.Message}";
		}
		finally
		{
			isBusy = false;
		}
	}

	private sealed record MessageSummaryRow(string Name, int Count, Color Color, string Description);
}
